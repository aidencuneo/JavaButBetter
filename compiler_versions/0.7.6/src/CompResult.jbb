LinkedHashMap[string, Class] classes
string startTemplate
string endTemplate
LinkedHashMap[Int, Int] lineMap

CompResult(
    LinkedHashMap[string, Class] classes,
    string startTemplate,
    string endTemplate,
    LinkedHashMap[Int, Int] lineMap,
):
    this.classes = classes
    this.startTemplate = startTemplate
    this.endTemplate = endTemplate
    this.lineMap = lineMap

bool hasCode:
    return true if classes[c].code for c in classes
    return false

string getCompiledCode:
    // Construct classes
    out = ""
    for c in classes
        // The null class is used to write code without a class
        if c == "null"
            out += classes[c].code
        elif classes[c].code.strip()
            out += classes[c]

    packageStr = ""
    if Compiler.packagePath
        packageStr = "package " + Compiler.packagePath + ";\n\n"

    return packageStr + startTemplate + "\n" + out + endTemplate

string getLineMapJSON:
    // Get offset from start template
    // offset = startTemplate.lines().count() + 1
    out = "{"

    for jbbLine in lineMap
        // javaLine = offset + lineMap[jbbLine]
        javaLine = lineMap[jbbLine]
        out += f"\"{jbbLine}\": {javaLine}, "

    out = out[:-2] while out.endsWith(", ")
    return out + "}"
